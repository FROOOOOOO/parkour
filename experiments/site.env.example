# Site configuration for the cluster experiment scripts.
#
# Copy this file to experiments/site.env and set the values for your cluster.
# The scripts load it through scripts/lib/common.sh. A variable that is already
# set in the environment keeps its value: each line only fills in an unset one.

# Prometheus endpoint the metric collectors query.
# Without it the scripts use http://localhost:9091.
#: "${PROMETHEUS_URL:=http://<MONITORING_IP>:9091}"

# The cluster's node subnet. It is added to NO_PROXY so that kubectl and curl
# reach the cluster directly even when a shell-level HTTP(S) proxy is set.
#: "${CLUSTER_SUBNET:=<CLUSTER_SUBNET>/24}"

# The etcd static pod that etcd-maintenance.sh compacts and defragments: on a
# kubeadm cluster, etcd-<control-plane node name>. The batch drivers call it
# after every experiment unless given --no-defrag.
#: "${ETCD_POD:=etcd-<CONTROL_PLANE_HOSTNAME>}"

# The application-layer benchmark (run-supplementary.sh, run-workload-bench.sh,
# preload-workload-images.sh) runs on three physical workers. MASTER_IP is the
# node that serves the benchmarks' NodePorts; WORKER_IPS and WORKER_NAMES list
# the workers' addresses and their Kubernetes node names, in the same order;
# SSH_USER logs in to the workers to load the workload images.
#: "${MASTER_IP:=<MASTER_IP>}"
#: "${WORKER_IPS:=<WORKER1_IP> <WORKER2_IP> <WORKER3_IP>}"
#: "${WORKER_NAMES:=<WORKER1_NAME> <WORKER2_NAME> <WORKER3_NAME>}"
#: "${SSH_USER:=<SSH_USER>}"
