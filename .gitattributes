# Normalize line endings automatically
* text=auto eol=lf

# Force LF for script-like file types
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Keep CRLF for Windows batch files (if any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Leave binary files untouched (prevents corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary