# 自动处理行尾符
* text=auto eol=lf

# 特定文件类型强制使用 LF（脚本类）
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Windows 批处理文件保留 CRLF（如果存在）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不处理（防止损坏）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary